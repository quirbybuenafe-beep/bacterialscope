<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <FrameLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/camera_preview" />

        <com.fungiscope.detector.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_vignette"
            android:clickable="false" />

        <View
            android:id="@+id/scanGuide"
            android:layout_width="292dp"
            android:layout_height="292dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_scan_guide" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="18dp"
            android:layout_marginTop="38dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/ic_bacteria_logo"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="BACTERIALSCOPE"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtModelState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="Loading detector…"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLiveChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_live_chip"
                android:fontFamily="sans-serif-medium"
                android:text="●  LIVE"
                android:textColor="@color/cell"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFlashDrawerToggle"
            android:layout_width="82dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="122dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_button_dark"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Flash"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/flashDrawer"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="168dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_gallery_panel"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ILLUMINATION"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnFlashOn"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="On"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFlashOff"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_dark"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Off"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtScanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="178dp"
            android:background="@drawable/bg_live_chip"
            android:text="Frame the culture or affected sample"
            android:textColor="@color/mist"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="238dp"
            android:background="@drawable/bg_result"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgLastCapture"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@string/captured_scan"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="SCAN SAVED"
                    android:textColor="@color/cell"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtLastResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_glass"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="COLONIES"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="38sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="2"
                        android:text="Ready to scan"
                        android:textColor="@color/mist"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="— ms"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtThreshold"
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="Confidence 40%"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

                <SeekBar
                    android:id="@+id/seekThreshold"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:max="80"
                    android:progress="30"
                    android:progressTint="@color/plasma"
                    android:thumbTint="@color/cell" />

                <Button
                    android:id="@+id/btnZoom"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_dark"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="1×"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="4dp"
                android:clipChildren="false">

                <Button
                    android:id="@+id/btnLive"
                    android:layout_width="82dp"
                    android:layout_height="46dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_button_dark"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Pause"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCapture"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_capture_ring"
                    android:contentDescription="Capture scan"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="" />

                <Button
                    android:id="@+id/btnGallery"
                    android:layout_width="82dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_button_dark"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Gallery"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/galleryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_gallery_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <Button
                android:id="@+id/btnGalleryBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_dark"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="CULTURE GALLERY"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtGallerySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="No saved scans"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGalleryInfo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_dark"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="⋯"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/galleryInfoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_gallery_panel"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtGalleryInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="No scan selected"
                android:textColor="@color/mist"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveToPhotos"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="0dp"
                android:text="Save to Photos"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDeletePhoto"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_danger"
                    android:minHeight="0dp"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnExportCsv"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:minHeight="0dp"
                    android:text="Export CSV"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnExportTraining"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="0dp"
                android:text="Export Training ZIP • 0 confirmed samples"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLearningMemory"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_dark"
                android:minHeight="0dp"
                android:text="Learning memory • 0 evaluations"
                android:textAllCaps="false"
                android:textColor="@color/cell"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_image_frame"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgGallery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/gallery_image"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txtGalleryEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="No saved scans yet\nCapture a sample to begin"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_live_chip"
                android:text="Swipe • pinch to zoom"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/galleryScroll"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@drawable/bg_gallery_panel"
            android:overScrollMode="never"
            android:paddingHorizontal="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/galleryStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
