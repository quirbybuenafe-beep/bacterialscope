<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#32FFFFFF" />
            <stroke android:width="2dp" android:color="#C655DDF6" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="#C6F7FF" android:endColor="#55DDF6" />
        </shape>
    </item>
</layer-list>
